# Copy to .env. Never commit .env.
LEADS_API_TOKEN=replace-with-a-long-random-string      # callers send it as x-api-key
OPENROUTER_API_KEY=sk-or-v1-replace-me
CONTACT_HASH_SECRET=replace-with-another-random-string  # keyed hashing for duplicate detection

# Primary first, then fallbacks. Free models rotate: check https://openrouter.ai/models?q=free
LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,openrouter/free

# Optional (defaults shown)
# LLM_BASE_URL=https://openrouter.ai/api/v1           # any OpenAI-compatible API
# LLM_API_KEY=                                         # used instead of OPENROUTER_API_KEY if set
# LLM_DATA_COLLECTION=allow                            # deny = providers that don't store prompts (most free models need allow)
# LLM_STRUCTURED_OUTPUT=true
# LLM_MAX_TOKENS=700
# LLM_ATTEMPTS_PER_MODEL=2
# LLM_MAX_ATTEMPTS_PER_LEAD=4
# LLM_TRANSPORT_RETRIES=2
# LLM_REQUESTS_PER_MINUTE=18                           # shared across all requests; free tier = 20/min
# LLM_MAX_CONCURRENCY=3
# LLM_PRICES_JSON={"openai/gpt-4o-mini":{"prompt":0.15,"completion":0.6}}   # USD per 1M tokens, if provider reports no cost
# RUN_BUDGET_USD=1.00
# BUSINESS_NAME=Bayline Digital
# DATABASE_PATH=data/runs.sqlite3
# MONTHLY_LEAD_VOLUME=8000
